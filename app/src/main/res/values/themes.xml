<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 베이스 테마 -->
    <style name="Base.Theme.JJB20" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- 전체 앱 공통 폰트 -->

        <!-- 상태바 밝기: 밝은 배경 → 아이콘/글씨는 검정색 -->
        <item name="android:windowLightStatusBar">true</item>

        <!-- 상태바 배경 색 -->
        <item name="android:statusBarColor">@color/white</item>

        <!-- 내비게이션 바 색 (선택) -->
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <!-- 앱 전체에서 사용할 테마 -->
    <style name="Theme.JJB20" parent="Base.Theme.JJB20" />

</resources>
