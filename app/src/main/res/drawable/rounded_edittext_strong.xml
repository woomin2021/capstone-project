<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 포커스 되었을 때 -->
    <item android:state_focused="true">
        <shape>
            <!-- 배경색 (고정) -->
            <solid android:color="#F3F7F7"/>
            <corners android:radius="12dp"/>
            <!-- 포커스 시 외곽선 -->
            <stroke android:width="2dp" android:color="#46C3A3"/>
        </shape>
    </item>

    <!-- 기본 상태 -->
    <item>
        <shape>
            <!-- 이메일칸 배경색 -->
            <solid android:color="#D9D9D9"/>
            <corners android:radius="12dp"/>
            <!-- 은은한 회색 테두리 -->
            <stroke android:width="1.5dp" android:color="#D0D4D4"/>
        </shape>
    </item>

</selector>