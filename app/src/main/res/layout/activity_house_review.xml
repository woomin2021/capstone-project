<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 스크롤 -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- 뒤로가기 버튼 -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back"
                android:padding="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- 제목 -->
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="리뷰 쓰기"
                android:textSize="20sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:fontFamily="@font/cafe24ssurroundotf"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:gravity="center"/>

            <!-- 상단 라인 -->
            <View
                android:id="@+id/topLine"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_marginTop="16dp"
                android:background="#16C6A3"
                app:layout_constraintTop_toBottomOf="@id/txtTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- 예약 정보 카드 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/boxReservation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/edittext_border"
                android:padding="14dp"
                app:layout_constraintTop_toBottomOf="@id/topLine"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- 집 이미지 -->
                <ImageView
                    android:id="@+id/imgHouse"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample1"
                    android:background="@drawable/profile_image"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <!-- 제목 -->
                <TextView
                    android:id="@+id/txtHouseName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="김디멜 집"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/cafe24ssurroundotf"
                    app:layout_constraintStart_toEndOf="@id/imgHouse"
                    app:layout_constraintTop_toTopOf="@id/imgHouse"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- 날짜 -->
                <TextView
                    android:id="@+id/txtDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="2025-06-05 ~ 2025-07-31"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:fontFamily="@font/cafe24ssurroundotf"
                    android:layout_marginTop="4dp"
                    app:layout_constraintStart_toStartOf="@id/txtHouseName"
                    app:layout_constraintTop_toBottomOf="@id/txtHouseName"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- 별점 -->
                <RatingBar
                    android:id="@+id/ratingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:numStars="5"
                    android:rating="4"
                    android:stepSize="1"
                    android:isIndicator="false"

                    app:layout_constraintStart_toStartOf="@id/txtHouseName"
                    app:layout_constraintTop_toBottomOf="@id/txtDate"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 리뷰 입력 박스 -->
            <EditText
                android:id="@+id/edtReview"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginTop="20dp"
                android:padding="14dp"
                android:background="@drawable/edittext_border"
                android:gravity="top|start"
                android:textSize="14sp"
                android:hint="리뷰를 작성해주세요."
                android:fontFamily="@font/cafe24ssurroundotf"
                android:inputType="textMultiLine"
                app:layout_constraintTop_toBottomOf="@id/boxReservation"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- 등록하기 버튼 -->
            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginTop="30dp"
                android:text="등록하기"
                android:textSize="16.5sp"
                android:fontFamily="@font/cafe24ssurroundotf"
                android:textColor="@color/white"
                android:backgroundTint="#16C6A3"
                app:layout_constraintTop_toBottomOf="@id/edtReview"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
