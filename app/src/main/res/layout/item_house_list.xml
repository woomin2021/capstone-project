<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:layout_marginVertical="8dp"
    android:padding="10dp"
    android:background="@drawable/edittext_border">

    <!-- 집 이미지 -->
    <ImageView
        android:id="@+id/imgHouse"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:scaleType="centerCrop"
        android:src="@drawable/sample1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clipToOutline="true"
        android:outlineProvider="background"
        android:background="@drawable/rounded_image_bg"
        />

    <!-- 집 이름 -->
    <TextView
        android:id="@+id/txtHouseName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="김수현 집"
        android:fontFamily="@font/cafe24ssurroundotf"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/imgHouse"
        app:layout_constraintTop_toTopOf="@id/imgHouse"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 주소 -->
    <TextView
        android:id="@+id/txtHouseAddress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="서울시 서대문구 홍은동 홍지문로"
        android:fontFamily="@font/cafe24ssurroundotf"
        android:textSize="13sp"
        android:textColor="#777777"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/imgHouse"
        app:layout_constraintTop_toBottomOf="@id/txtHouseName"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 가격 -->
    <TextView
        android:id="@+id/txtHousePrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="520,200 / 박"
        android:textSize="14sp"
        android:fontFamily="@font/cafe24ssurroundotf"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toEndOf="@id/imgHouse"
        app:layout_constraintTop_toBottomOf="@id/txtHouseAddress" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnEdit"
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:text="수정하기"
        android:textSize="10sp"
        app:layout_constraintEnd_toStartOf="@id/btnDelete"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/cafe24ssurroundotf"
        android:textColor="@color/white"
        android:background="@drawable/btn_mainbtn"
        android:backgroundTint="@color/mainColor1"

        />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDelete"
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:text="삭제하기"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fontFamily="@font/cafe24ssurroundotf"
        android:textColor="@color/white"
        android:background="@drawable/btn_mainbtn"
        android:backgroundTint="@color/mainColor1"

        />

</androidx.constraintlayout.widget.ConstraintLayout>
