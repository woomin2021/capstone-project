<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- 상단바 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/app_title"
            android:text="집잡빌"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cafe24ssurroundotf"/>

        <ImageView
            android:id="@+id/btn_profile"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_user"/>
    </LinearLayout>


    <!-- 로고 이미지 -->
    <ImageView
        android:id="@+id/logo_img"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/main_1"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- 타이틀 (두 줄로 분리) -->
    <LinearLayout
        android:id="@+id/main_title_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/logo_img"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1줄: 집 잠시(초록) + 시(기본색) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title1_part1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="집 잠"
                android:textColor="#00A08A"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/title1_part2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시"
                android:textColor="#333333"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <!-- 2줄: 빌(초록) + 려드립니다(기본색) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/title2_part1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="빌"
                android:textColor="#00A08A"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/title2_part2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="려드립니다"
                android:textColor="#333333"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>


    <!-- 집 빌리기 카드 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnRent"
        android:layout_width="0dp"
        android:layout_height="101dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="40dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#00CBA8"
        app:layout_constraintTop_toBottomOf="@id/main_title_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRentCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="취향껏 찾아봐요"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:alpha="0.8"
                    android:fontFamily="@font/cafe24ssurround_v2"/>

                <TextView
                    android:id="@+id/tvRentTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="집 빌리기"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="@font/cafe24ssurround_v2"/>
            </LinearLayout>

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_rent"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


    <!-- 집 등록하기 카드 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnRegister"
        android:layout_width="0dp"
        android:layout_height="101dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F3F7F7"
        app:strokeWidth="1dp"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/btnRent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="N분이면 끝나요"
                    android:textSize="12sp"
                    android:alpha="0.8"
                    android:fontFamily="@font/cafe24ssurround_v2"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="집 등록하기"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/cafe24ssurround_v2"/>
            </LinearLayout>

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_register"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
