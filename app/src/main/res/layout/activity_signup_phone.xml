<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:ignore="ContentDescription">

    <!-- 뒤로가기 -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/arrow_left"
        app:tint="#333333"
        android:contentDescription="@string/back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 제목 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/cafe24ssurround_v2"
        android:gravity="center"
        android:text="@string/signup_title"
    android:textColor="#333333"
    android:textSize="18sp"
    android:textStyle="bold"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <!-- 섹션 라벨: 전화번호 -->
    <TextView
        android:id="@+id/tvPhoneLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/cafe24ssurround_v2"
        android:text="@string/phone_label"
    android:textColor="#333333"
    android:textSize="18sp"
    android:textStyle="bold"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- 전화번호 입력 -->
    <EditText
        android:id="@+id/etPhone"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        android:hint="@string/phone_hint"
    android:inputType="phone"
    android:autofillHints="phone"
    android:textSize="16sp"
    android:textColor="@android:color/black"
    android:textColorHint="#888888"
    android:fontFamily="@font/cafe24ssurround_v2"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp"
    android:gravity="center_vertical"
    android:background="@drawable/rounded_edittext_strong"
    android:drawablePadding="12dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toBottomOf="@id/tvPhoneLabel" />

    <!-- 안내문구 -->
    <TextView
        android:id="@+id/tvHelper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/phone_helper"
        android:textColor="#909090"
        android:textSize="12sp"
        android:fontFamily="@font/cafe24ssurround_v2"
        app:layout_constraintStart_toStartOf="@id/etPhone"
        app:layout_constraintEnd_toEndOf="@id/etPhone"
        app:layout_constraintTop_toBottomOf="@id/etPhone" />

    <!-- 다음 버튼  -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:minWidth="0dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/next"
        android:textColor="@android:color/white"
        android:fontFamily="@font/cafe24ssurround_v2"
        app:backgroundTint="@color/teal_00cba8"
        app:cornerRadius="28dp"
        app:layout_constraintTop_toBottomOf="@id/tvHelper"
        app:layout_constraintEnd_toEndOf="@id/etPhone" />
</androidx.constraintlayout.widget.ConstraintLayout>