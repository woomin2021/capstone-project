<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:gravity="top|center_horizontal">

        <!-- 텍스트 로고  -->
        <TextView
            android:id="@+id/logoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_gravity="start"
            android:gravity="start"
            android:includeFontPadding="false"
            android:text="집잠빌"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/cafe24ssurround_v2" />

        <!-- 상단 로고 이미지 -->
        <ImageView
            android:id="@+id/mainImage"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/main_1" />

        <!-- 타이틀 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <!-- 집 잠 -->
            <TextView
                android:id="@+id/title1_part1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="집 잠"
                android:textColor="#46C3A3"
                android:textStyle="bold"
                android:textSize="28sp"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:includeFontPadding="false"/>

            <!-- 시 → 일반 색 -->
            <TextView
                android:id="@+id/title1_part2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시"
                android:textColor="#333333"
                android:textStyle="bold"
                android:textSize="28sp"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <!-- 빌려드립니다 -->
        <LinearLayout
            android:id="@+id/title2_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextView
                android:id="@+id/title2_part1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="빌"
                android:textColor="#46C3A3"
                android:textStyle="bold"
                android:textSize="28sp"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/title2_part2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="려드립니다"
                android:textColor="#333333"
                android:textStyle="bold"
                android:textSize="28sp"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <!-- 이메일 -->
        <EditText
            android:id="@+id/etUserID"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="24dp"
            android:hint="이메일"
            android:inputType="textEmailAddress"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:fontFamily="@font/cafe24ssurround_v2"
            android:textColorHint="#888888"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:gravity="center_vertical"
            android:background="@drawable/rounded_edittext_strong"

            android:drawablePadding="12dp" />

        <!-- 비밀번호 -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:hint="비밀번호"
            android:inputType="textPassword"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:textColorHint="#888888"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:gravity="center_vertical"
            android:background="@drawable/rounded_edittext_strong"
            android:fontFamily="@font/cafe24ssurround_v2"
            android:drawablePadding="12dp" />

        <!-- 로그인 버튼  -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="로그인"
            android:textColor="@android:color/white"
            android:fontFamily="@font/cafe24ssurround_v2"
            app:cornerRadius="28dp"
            app:backgroundTint="@color/teal_00cba8" />

        <!-- 회원가입 버튼  -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignup"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="회원가입"
            android:fontFamily="@font/cafe24ssurround_v2"
            android:textColor="@color/signup_text_333"
            android:minHeight="0dp"
            android:paddingVertical="10dp"
            app:cornerRadius="28dp"
            app:backgroundTint="@color/signup_bg_f3f7f7"
            app:strokeColor="@color/signup_stroke"
            app:strokeWidth="1dp" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@android:color/white"
            android:text="구글 로그인"
            android:textSize="16sp"
            android:textColor="@color/signup_text_333"
            android:fontFamily="@font/cafe24ssurround_v2"
            app:cornerRadius="28dp"
            app:strokeWidth="1dp"
            app:strokeColor="#D0D0D0"
            app:icon="@drawable/sibal_logo"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@null"
            app:iconSize="33dp"
            android:paddingStart="0dp"
            android:paddingEnd="16dp"/>





        <!-- 하단 여백 -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="31dp" />
    </LinearLayout>
</ScrollView>