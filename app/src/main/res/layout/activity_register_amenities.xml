<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fontFamily="@font/cafe24ssurroundotf">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/arrow_left"
            app:title="집 등록하기"
            app:titleTextAppearance="@style/ToolbarTitleTextStyle"
            app:titleTextColor="#212121" />

    </com.google.android.material.appbar.AppBarLayout>

    <ProgressBar
        android:id="@+id/progressBarStep"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:max="6"
        android:progress="3"
        android:progressTint="#14D8B4"
        android:progressBackgroundTint="#D9D9D9"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/next_button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:text="다음"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="#00CBA8"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:fillViewport="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/next_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBarStep">

        <LinearLayout
            android:id="@+id/amenities_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/subtitle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_gravity="center"
                android:text="편의시설 정보를\n추가해주세요"
                android:fontFamily="@font/cafe24ssurroundotf"
                android:textAlignment="center"
                android:textColor="#1ABC9C"
                android:textSize="25sp"
                android:textStyle="bold" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="주차장"
                android:textSize="16sp"
                android:checked="false"
                android:fontFamily="@font/cafe24ssurround_v2"
                app:buttonTint="@color/teal_00cba8"
                android:drawablePadding="16dp"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="와이파이"
                android:checked="false"
                android:fontFamily="@font/cafe24ssurround_v2"
                app:buttonTint="@color/teal_00cba8"
                android:textSize="16sp"
                android:drawablePadding="16dp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="에어컨"
                android:checked="false"
                android:fontFamily="@font/cafe24ssurround_v2"
                app:buttonTint="@color/teal_00cba8"
                android:textSize="16sp"
                android:drawablePadding="16dp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="난방"
                android:checked="false"
                android:fontFamily="@font/cafe24ssurround_v2"
                app:buttonTint="@color/teal_00cba8"
                android:textSize="16sp"
                android:drawablePadding="16dp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="주방"
                android:checked="false"
                android:fontFamily="@font/cafe24ssurround_v2"
                app:buttonTint="@color/teal_00cba8"
                android:textSize="16sp"
                android:drawablePadding="16dp"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="세탁기"
                android:checked="false"
                android:fontFamily="@font/cafe24ssurround_v2"
                app:buttonTint="@color/teal_00cba8"
                android:textSize="16sp"
                android:drawablePadding="16dp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="건조기"
                android:checked="false"
                android:fontFamily="@font/cafe24ssurround_v2"
                app:buttonTint="@color/teal_00cba8"
                android:textSize="16sp"
                android:drawablePadding="16dp"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:drawablePadding="16dp"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:text="욕조"
                android:textSize="16sp"
                app:buttonTint="@color/teal_00cba8" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="식탁"
                android:checked="false"
                android:fontFamily="@font/cafe24ssurround_v2"
                app:buttonTint="@color/teal_00cba8"
                android:textSize="16sp"
                android:drawablePadding="16dp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="전자레인지"
                android:checked="false"
                android:fontFamily="@font/cafe24ssurround_v2"
                app:buttonTint="@color/teal_00cba8"
                android:textSize="16sp"
                android:drawablePadding="16dp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="냉장고"
                android:checked="false"
                android:fontFamily="@font/cafe24ssurround_v2"
                app:buttonTint="@color/teal_00cba8"
                android:textSize="16sp"
                android:drawablePadding="16dp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TV"
                android:checked="false"
                android:fontFamily="@font/cafe24ssurround_v2"
                app:buttonTint="@color/teal_00cba8"
                android:textSize="16sp"
                android:drawablePadding="16dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>