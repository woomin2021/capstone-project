<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".PaymentActivity"> <com.google.android.material.appbar.MaterialToolbar
    android:id="@+id/toolbar"
    style="@style/Widget.MaterialComponents.Toolbar"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:navigationIcon="@drawable/arrow_left"
    app:title="집 빌리기"
    app:titleCentered="true"
    app:titleTextAppearance="@style/ToolbarTitleTextStyle" />

    <LinearLayout
        android:id="@+id/progressRow"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/seg1"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="#14D8B4" />

        <View
            android:id="@+id/seg2"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="#14D8B4" />

        <View
            android:id="@+id/seg3"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="#14D8B4" />

        <View
            android:id="@+id/seg4"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="#E6E6E6" />
    </LinearLayout>

    <TextView
        android:id="@+id/sectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="결제 페이지로 이동"
        android:fontFamily="@font/cafe24ssurround_v2"

        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/progressRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textPaymentInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="결제 수단을 선택하고 결제를 진행하세요."
        android:fontFamily="@font/cafe24ssurround_v2"

        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#222222"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/sectionTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 결제 버튼 3종 -->
    <LinearLayout
        android:id="@+id/paymentButtonsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="175dp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/textPaymentInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. 토스페이 결제하기 -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="토스페이"
            android:textSize="16sp"
            android:checked="false"
            android:fontFamily="@font/cafe24ssurround_v2"
            app:buttonTint="@color/teal_00cba8"
            android:drawablePadding="16dp"/>

        <!-- 2. 일반 결제하기 -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="현장결제"
            android:textSize="16sp"
            android:checked="false"
            android:fontFamily="@font/cafe24ssurround_v2"
            app:buttonTint="@color/teal_00cba8"
            android:drawablePadding="16dp"/>



    </LinearLayout>



    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="20dp"
        android:textSize="20sp"
        android:text="결제하기"
        app:cornerRadius="16dp"
        android:background="@drawable/btn_mainbtn"
        android:fontFamily="@font/cafe24ssurround_v2"

        android:textColor="@color/basic1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>