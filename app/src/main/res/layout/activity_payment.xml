<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".PaymentActivity"> <com.google.android.material.appbar.MaterialToolbar
    android:id="@+id/toolbar"
    style="@style/Widget.MaterialComponents.Toolbar"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:navigationIcon="@drawable/arrow_left"
    app:title="집 빌리기"
    app:titleCentered="true"
    app:titleTextAppearance="@style/ToolbarTitleTextStyle" />

    <LinearLayout
        android:id="@+id/progressRow"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/seg1"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="#14D8B4" />

        <View
            android:id="@+id/seg2"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="#14D8B4" />

        <View
            android:id="@+id/seg3"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="#14D8B4" />

        <View
            android:id="@+id/seg4"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="#E6E6E6" />
    </LinearLayout>

    <TextView
        android:id="@+id/sectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="결제 페이지로 이동"
        android:fontFamily="@font/cafe24ssurround_v2"

        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/progressRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textPaymentInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="결제 수단을 주의사항을 보고 넘어가세요."
        android:fontFamily="@font/cafe24ssurround_v2"

        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#222222"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/sectionTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 결제 버튼과 주의사항 -->
    <LinearLayout
        android:id="@+id/paymentButtonsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/textPaymentInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 현장 결제 안내 제목 -->
        <TextView
            android:id="@+id/tvOnsitePaymentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="현장 결제 안내"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#2C2C2C"
            android:fontFamily="@font/cafe24ssurround_v2"
            android:paddingVertical="8dp"/>

        <!-- 현장 결제 주의사항 박스 -->
        <LinearLayout
            android:id="@+id/layoutOnsiteWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"

            android:padding="14dp">

            <TextView
                android:id="@+id/tvWarning1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• 현장 결제는 사전에 호스트와 반드시 결제 방법을 확인해주세요."
                android:textSize="15sp"
                android:textColor="#555555"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:lineSpacingExtra="4dp"/>

            <TextView
                android:id="@+id/tvWarning2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• 계좌이체 또는 현금 결제 시 영수증 요청이 불가능해요."
                android:textSize="15sp"
                android:textColor="#555555"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"/>

            <TextView
                android:id="@+id/tvWarning3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• 사기거래 방지를 위해 결제 완료 전 송금하지 않도록 주의해주세요."
                android:textSize="15sp"
                android:textColor="#D9534F"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"/>

            <TextView
                android:id="@+id/tvWarning4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• 결제 완료 후 호스트의 채팅을 기다려 주세요."
                android:textSize="15sp"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

    </LinearLayout>



    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="20dp"
        android:textSize="20sp"
        android:text="결제하기"
        app:cornerRadius="16dp"
        android:background="@drawable/btn_mainbtn"
        android:fontFamily="@font/cafe24ssurround_v2"

        android:textColor="@color/basic1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>