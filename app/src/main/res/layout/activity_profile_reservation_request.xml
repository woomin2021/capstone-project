<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🔹 기존 내용 전부를 감싸는 LinearLayout -->
    <LinearLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- 상단바 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/arrow_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/section_tit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cafe24ssurroundotf"
                android:text="받은 예약 요청"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 탭 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCurrentRequests"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="요청 내역"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:background="@drawable/btn_mainbtn"
                android:paddingVertical="10dp"
                android:layout_marginEnd="8dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTradeDoneRequests"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="예약 성사"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:background="@drawable/btn_mainbtn"
                android:paddingVertical="10dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPastRequests"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="지난 요청"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:background="@drawable/btn_mainbtn"
                android:paddingVertical="10dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- 예약 리스트 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/requestListRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"/>
    </LinearLayout>

    <!-- 🔹 항상 맨 위에 덮어쓰는 채팅 오버레이 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/chat_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_transparent"
        android:elevation="10dp"
        android:visibility="gone" />

</FrameLayout>
