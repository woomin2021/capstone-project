<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 뒤로가기 -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/arrow_left"
        app:tint="#333333"
        android:contentDescription="@string/back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 타이틀 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="전화번호 인증하기"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="#333333"
        android:gravity="center"
        android:fontFamily="@font/cafe24ssurround_v2"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>

    <!-- 안내문구 -->
    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="문자 메세지를 통해 010 - 0000-0000 번호로 보내드린 코드를 입력하세요."
        android:textColor="#333333"
        android:textSize="16sp"
        android:fontFamily="@font/cafe24ssurround_v2"
        android:lineSpacingExtra="2dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>

    <!-- 인증코드 입력 (6자리)  -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:boxBackgroundMode="outline"
        app:boxBackgroundColor="#FFFFFF"
        app:boxStrokeColor="#E5E8E8"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:hintEnabled="false"
        app:layout_constraintTop_toBottomOf="@id/tvDesc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">

        <!-- 하나의 필드로 6자리 입력 -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:inputType="number"
            android:maxLength="6"

            android:digits="0123456789"
            android:hint="   -  -  -  -  -"
            android:textColor="#333333"
            android:textColorHint="#BDBDBD"
            android:background="@null"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:letterSpacing="0.35"
            android:fontFamily="monospace"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 코드를 받지 못하셨나요? / 다시 보내기 -->
    <TextView
        android:id="@+id/tvHelp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="코드를 받지 못하셨나요?"
        android:textColor="#333333"
        android:textSize="16sp"
        android:fontFamily="@font/cafe24ssurround_v2"
        app:layout_constraintStart_toStartOf="@id/tilCode"
        app:layout_constraintTop_toBottomOf="@id/tilCode"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/tvResend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="다시 보내기"
        android:textStyle="bold"
        android:fontFamily="@font/cafe24ssurround_v2"
        android:textColor="#666666"
        android:textSize="16sp"
        android:paddingStart="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintStart_toEndOf="@id/tvHelp"
        app:layout_constraintBaseline_toBaselineOf="@id/tvHelp"/>

    <!-- 계속하기 버튼 (하단 우측) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:minWidth="0dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="계속하기"
        android:textColor="@android:color/white"
        app:cornerRadius="28dp"
        app:backgroundTint="@color/teal_00cba8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/cafe24ssurround_v2"
        android:layout_marginBottom="24dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>