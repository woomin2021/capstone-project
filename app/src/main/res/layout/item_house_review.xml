<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="14dp"
    android:paddingHorizontal="6dp">

    <!-- 상단: 프로필 이미지 + 이름 + 날짜 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/review_profile_img"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/profile_image"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_mask" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/review_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="홍길동"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/cafe24ssurroundotf" />

            <TextView
                android:id="@+id/review_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3일 전"
                android:textSize="12sp"
                android:textColor="#777"
                android:fontFamily="@font/cafe24ssurroundotf" />
        </LinearLayout>
    </LinearLayout>

    <!-- 별점 -->
    <RatingBar
        android:id="@+id/review_rating"
        style="?android:attr/ratingBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="0.5"
        android:layout_marginTop="6dp"
        android:rating="4.5"
        android:progressTint="@color/mainColor1"
        android:secondaryProgressTint="@color/mainColor1"
        android:progressBackgroundTint="@color/basic2"/>

    <!-- 내용 -->
    <TextView
        android:id="@+id/review_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="14sp"
        android:textColor="#333"
        android:text="리뷰 내용이 들어갑니다."
        android:fontFamily="@font/cafe24ssurroundotf" />

</LinearLayout>
