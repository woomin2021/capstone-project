<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 뒤로가기 -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/arrow_left"
        app:tint="#333333"
        android:contentDescription="@string/back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 상단 가운데 타이틀 -->
    <TextView
        android:id="@+id/tvTopTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="호스트 등록하기"
        android:textColor="#333333"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:fontFamily="@font/cafe24ssurround_v2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack"/>

    <!-- 폼 영역 -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/tvTopTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">


            <!-- 라벨: 사업자번호 -->
            <TextView
                android:id="@+id/labelBNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="사업자 번호"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:layout_marginTop="8dp"/>


            <!-- 사업자 번호 기입 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBNum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#E5E8E8"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBNum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="10"
                    android:paddingTop="12dp"
                    android:fontFamily="@font/cafe24ssurround_v2"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#333333"
                    android:textColorHint="#BDBDBD"
                    android:background="@null"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 입력 안내 -->
            <TextView
                android:id="@+id/helpBNum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="사업자번호는 10자로 입력해야 합니다."
                android:textSize="12sp"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:textColor="#8C8C8C"
                android:lineSpacingExtra="2dp"/>

            <!-- 라벨: 호스팅정책 -->
            <TextView
                android:id="@+id/labelHostingPolicy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="호스팅 정책"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/cafe24ssurround_v2"/>

            <!-- 호스팅 정책 기입 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilHostingPolicy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#E5E8E8"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHostingPolicy"
                    android:layout_width="match_parent"
                    android:hint="게스트와의 소통 및 안내사항"
                    android:layout_height="200dp"
                    android:paddingTop="12dp"
                    android:fontFamily="@font/cafe24ssurround_v2"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"

                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:textColorHint="#BDBDBD"
                    android:background="@drawable/edittext_border"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 정책 안내 -->
            <TextView
                android:id="@+id/helpHostingPolicy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="집 사용 매뉴얼을 작성하여 집에 대한 정보를 알려주세요."
                android:textSize="12sp"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:textColor="#8C8C8C"
                android:lineSpacingExtra="2dp"/>


            <!-- 다음 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="다음"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:textColor="@android:color/white"
                app:cornerRadius="28dp"
                app:backgroundTint="@color/teal_00cba8"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>