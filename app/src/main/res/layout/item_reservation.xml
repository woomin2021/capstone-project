<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:padding="12dp"
    android:background="@drawable/edittext_border"
    android:layout_marginVertical="8dp">

    <TextView
        android:id="@+id/txtReservationId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="예약번호 #12"
        android:fontFamily="@font/cafe24ssurround_v2"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtDateRange"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="2025-01-01 ~ 2025-01-03"
        android:fontFamily="@font/cafe24ssurround_v2"
        android:textSize="14sp"
        android:textColor="#555555"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/txtReservationId"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtGuestCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="인원: 3명"
        android:fontFamily="@font/cafe24ssurround_v2"
        android:textSize="14sp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/txtDateRange"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtTotalPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₩ 240,000"
        android:fontFamily="@font/cafe24ssurround_v2"
        android:textStyle="bold"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
