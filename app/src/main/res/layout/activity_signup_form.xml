<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 뒤로가기 -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/arrow_left"
        app:tint="#333333"
        android:contentDescription="@string/back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 상단 가운데 타이틀 -->
    <TextView
        android:id="@+id/tvTopTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="집 등록하기"
        android:textColor="#333333"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:fontFamily="@font/cafe24ssurround_v2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack"/>

    <!-- 폼 영역 -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/tvTopTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- 큰 헤더: 회원가입 -->
            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="회원가입"
                android:textColor="#111111"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"/>

            <!-- 라벨: 실명 -->
            <TextView
                android:id="@+id/labelRealName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="실명"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:layout_marginTop="8dp"/>

            <!-- 이름(길동) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFirstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#E5E8E8"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="신분증에 기재된 이름(예: 길동)"
                    android:fontFamily="@font/cafe24ssurround_v2"
                    android:paddingTop="12dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#333333"
                    android:textColorHint="#BDBDBD"
                    android:background="@null"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 성(홍) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#E5E8E8"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLastName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:hint="신분증에 기재된 성(예: 홍)"
                    android:fontFamily="@font/cafe24ssurround_v2"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#333333"
                    android:textColorHint="#BDBDBD"
                    android:background="@null"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 실명 안내 -->
            <TextView
                android:id="@+id/helpRealName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="정부 발급 신분증에 기재된 이름과 일치해야 합니다. 평소 다른 이름을 사용하는 경우, 선호하는 이름을 입력하세요."
                android:textSize="12sp"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:textColor="#8C8C8C"
                android:lineSpacingExtra="2dp"/>

            <!-- 라벨: 생년월일 -->
            <TextView
                android:id="@+id/labelBirth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="생년월일"

                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/cafe24ssurround_v2"/>

            <!-- 생일(6자리) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBirth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#E5E8E8"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBirth"
                    android:layout_width="match_parent"
                    android:hint="생일(6자리)"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:inputType="number"
                    android:maxLength="6"
                    android:fontFamily="@font/cafe24ssurround_v2"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#333333"
                    android:textColorHint="#BDBDBD"
                    android:background="@null"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 생년월일 안내 -->
            <TextView
                android:id="@+id/helpBirth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="18세 이상의 성인만 회원으로 가입할 수 있습니다. 생일은 다른 집잡빌 이용자에게 공개되지 않습니다."
                android:textSize="12sp"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:textColor="#8C8C8C"
                android:lineSpacingExtra="2dp"/>

            <!-- 이메일 -->
            <TextView
                android:id="@+id/labelEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="이메일"
                android:textColor="#111111"

                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/cafe24ssurround_v2"/>

            <!-- 이메일 입력 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#E5E8E8"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:inputType="textEmailAddress"
                    android:hint="이메일"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cafe24ssurround_v2"
                    android:paddingTop="12dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#333333"
                    android:textColorHint="#BDBDBD"
                    android:background="@null"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 이메일 안내 -->
            <TextView
                android:id="@+id/helpEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="예약확인 이메일이 전송됩니다."
                android:fontFamily="@font/cafe24ssurround_v2"
                android:textSize="12sp"
                android:textColor="#8C8C8C"
                android:lineSpacingExtra="2dp"/>

            <!-- 전화번호 -->
            <TextView
                android:id="@+id/labelphone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="전화번호"
                android:textColor="#111111"

                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/cafe24ssurround_v2"/>

            <!-- 전화번호   입력 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilphone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#E5E8E8"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etphone"
                    android:layout_width="match_parent"
                    android:inputType="textEmailAddress"
                    android:hint="전화번호"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cafe24ssurround_v2"
                    android:paddingTop="12dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#333333"
                    android:textColorHint="#BDBDBD"
                    android:background="@null"/>
            </com.google.android.material.textfield.TextInputLayout>
            <!-- 이메일 안내 -->
            <TextView
                android:id="@+id/helpphone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="예약확인 문자가 번호로 전송됩니다."
                android:fontFamily="@font/cafe24ssurround_v2"
                android:textSize="12sp"
                android:textColor="#8C8C8C"
                android:lineSpacingExtra="2dp"/>
            <!-- 프로필 사진 -->
            <TextView
                android:id="@+id/labelProfilePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="프로필 사진"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- 프로필 사진 추가 카드 (1장만 사용해도 됨 여러장 가능 ) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardProfilePhoto"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        app:cardCornerRadius="8dp"
                        app:cardBackgroundColor="#F5F5F5"
                        app:cardElevation="0dp"
                        app:strokeColor="#EEEEEE"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <!-- 나중에 선택된 사진을 이 ImageView에 넣을 수 있게 하면 될듯 -->
                            <ImageView
                                android:id="@+id/imgProfilePhoto"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_camera_alt"
                                app:tint="#757575" />

                            <TextView
                                android:id="@+id/tvProfilePhotoHint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="사진 추가"
                                android:textColor="#757575"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>


            <!--  비밀번호 -->
            <TextView
                android:id="@+id/labelPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="비밀번호"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/cafe24ssurround_v2"/>

            <!-- 비밀번호 입력 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                app:boxBackgroundColor="#FFFFFF"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#E5E8E8"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="password_toggle"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="비밀번호"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:fontFamily="@font/cafe24ssurround_v2"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:textColor="#333333"
                    android:textColorHint="#BDBDBD" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 비밀번호 표시 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비밀번호 표시"
                    android:fontFamily="@font/cafe24ssurround_v2"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:layout_marginEnd="6dp"/>

                <CheckBox
                    android:id="@+id/cbShowPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- 개인정보 동의 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="start|center_vertical">

                <CheckBox
                    android:id="@+id/cbConsent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cafe24ssurround_v2"
                    android:text="개인정보 수집 및 이용에 동의합니다."
                    android:textColor="#111111"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 다음 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="다음"
                android:fontFamily="@font/cafe24ssurround_v2"
                android:textColor="@android:color/white"
                app:cornerRadius="28dp"
                app:backgroundTint="@color/teal_00cba8"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>